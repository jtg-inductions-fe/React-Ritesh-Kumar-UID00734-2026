{
    "compilerOptions": {
        "baseUrl": "./src",
        "paths": {
            "@assets/*": ["assets/*"],
            "@components/*": ["components/*"],
            "@constants": ["constants/index"],
            "@containers/*": ["containers/*"],
            "@features/*": ["features/*"],
            "@hooks/*": ["hooks/*"],
            "@layouts/*": ["layouts/*"],
            "@pages/*": ["pages/*"],
            "@routes/*": ["routes/*"],
            "@services/*": ["services/*"],
            "@store": ["store/index"],
            "@theme": ["theme/index"],
            "@utils/*": ["utils/*"],
            "@_types/*": ["types/*"],
            "@tests/*": ["tests/*"]
        }
    }
}
